# MySQL connection string (Prisma)
DATABASE_URL="mysql://u858169390_store_user:YOUR_PASSWORD@127.0.0.1:3306/u858169390_store_db"

# HTTP port the API server listens on
PORT=4000

# Comma-separated list of allowed frontend origins (CORS). Add your production domain:
#   http://localhost:3000,https://yourstore.com
FRONTEND_URL=http://localhost:3000

# AES-256-GCM encryption key (min 32 chars). Use a long random string.
APP_ENCRYPTION_KEY=replace-with-a-32-character-minimum-secret-key