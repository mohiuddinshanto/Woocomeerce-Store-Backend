# MySQL connection string (Prisma)
DATABASE_URL="mysql://u858169390_store_user:YOUR_PASSWORD@127.0.0.1:3306/u858169390_store_db"

# HTTP port the API server listens on
PORT=4000

# Comma-separated list of allowed frontend origins (CORS). Add your production domain:
#   http://localhost:3000,https://yourstore.com
FRONTEND_URL=http://localhost:3000

# AES-256-GCM encryption key (min 32 chars). Use a long random string.
APP_ENCRYPTION_KEY=replace-with-a-32-character-minimum-secret-key

# ---------------------------------------------------------------------------
# Docker Compose deployment (docker compose up -d --build)
# These variables are used by docker-compose.yml substitution. For a plain
# `node dist/server.js` run, only DATABASE_URL/PORT/FRONTEND_URL are needed.
# ---------------------------------------------------------------------------

# MySQL database (created by the db service)
MYSQL_DATABASE=store_db
MYSQL_USER=store_user
MYSQL_PASSWORD=change_me_strong_password
MYSQL_ROOT_PASSWORD=change_me_root_password

# Backend URL reachable from the browser (the frontend build uses this)
API_URL=http://localhost:4000